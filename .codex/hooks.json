{
  "description": "Trip Split Bash safety hook.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/block-dangerous-command.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & (Join-Path $root '.codex\\hooks\\block-dangerous-command.ps1')\"",
            "statusMessage": "Checking Bash command"
          }
        ]
      }
    ]
  }
}
