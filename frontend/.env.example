# 전환 전 React/Vite 목업 전용입니다. Flutter scaffold 뒤에는 Dart 환경 계약으로 교체합니다.
# mock은 Firebase 없이 강릉·도쿄 fixture로 실행합니다.
VITE_DATA_SOURCE=mock

# Firebase Console의 Web App 구성값입니다. 비밀 키가 아니지만 환경별로 분리합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3

# 로컬 Emulator 사용 시 true로 설정합니다.
VITE_USE_FIREBASE_EMULATORS=false
