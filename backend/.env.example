# Firebase Emulator/Functions의 일반 환경변수 예시입니다.
FUNCTIONS_REGION=asia-northeast3
SHARE_CODE_LENGTH=8

# parseReceipt provider adapter의 비밀이 아닌 설정 예시입니다.
# provider는 일본어 fixture benchmark 뒤 확정하며 기본값은 외부 호출 없는 mock입니다.
RECEIPT_OCR_PROVIDER=mock
RECEIPT_TRANSLATION_TARGET=ko
RECEIPT_MAX_IMAGE_BYTES=5242880

# Google Document AI를 채택할 때만 사용하는 비밀이 아닌 식별자입니다.
DOCUMENT_AI_LOCATION=
DOCUMENT_AI_EXPENSE_PROCESSOR_ID=

# 배포 환경은 Functions runtime service account를, 로컬은 승인된 ADC를 사용합니다.
# service-account JSON, API key와 provider secret은 이 파일이나 Git에 넣지 않습니다.
# 다른 OCR provider를 채택하면 adapter별 secret을 Firebase Functions secret으로 등록합니다.
